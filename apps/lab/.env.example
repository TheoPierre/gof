# Mesure d'audience. Sans ces variables, rien n'est envoyé : le développement
# local est silencieux par défaut, et c'est voulu.
#
# La région UE est un choix, pas un détail : elle évite d'exporter les données
# hors de l'Union et simplifie tout le volet RGPD.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
